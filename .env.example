# IA Provider: mock, openai, anthropic
AI_PROVIDER=mock

# OpenAI (optional)
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-3.5-turbo

# Anthropic (optional)
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-haiku-20240307

# Server
SERVER_PORT=3000
STAGE=dev
LOG_LEVEL=info

# AWS/Serverless
AWS_REGION=us-east-1
LAMBDA_MEMORY=256
LAMBDA_TIMEOUT=30
